<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <title>戰況即時計算</title>
  <style>
    body { font-family: sans-serif; background:#111; color:#eee; padding:20px }
    h2 { margin-top:30px }
    .team { border:1px solid #444; padding:10px; margin-bottom:20px }
    .player { margin:5px 0 }
    button { margin:2px }
    .money { font-weight:bold; color:#0f0 }
    .setting { background:#222; padding:10px; margin-bottom:20px }
  </style>
</head>
<body>

<h1>即時戰況計算</h1>

<div class="setting">
  <h2>系統設定（刷新不會消失）</h2>
  贏底：<input type="number" id="winBase" />  
  普通球單顆：<input type="number" id="normal1" />  
  普通球兩顆：<input type="number" id="normal2" />  
  彩蛋球：<input type="number" id="egg" />
  <button onclick="saveSetting()">儲存設定</button>
</div>

<div class="team">
  <h2>🔵 藍隊</h2>
  <div id="bluePlayers"></div>
</div>

<div class="team">
  <h2>🔴 紅隊</h2>
  <div id="redPlayers"></div>
</div>

<script>
/* ====== 初始設定 ====== */
const defaultSetting = {
  winBase: 75,
  normal1: 50,
  normal2: 150,
  egg: 50
}

let setting = JSON.parse(localStorage.getItem('setting')) || defaultSetting

document.getElementById('winBase').value = setting.winBase
document.getElementById('normal1').value = setting.normal1
document.getElementById('normal2').value = setting.normal2
document.getElementById('egg').value = setting.egg

function saveSetting(){
  setting = {
    winBase: +winBase.value,
    normal1: +normal1.value,
    normal2: +normal2.value,
    egg: +egg.value
  }
  localStorage.setItem('setting', JSON.stringify(setting))
  alert('設定已儲存')
}

/* ====== 假資料（你之後可接會員） ====== */
const blueTeam = [
  { name:'阿樂', normal:0, egg:0, money:0 },
  { name:'阿重', normal:0, egg:0, money:0 }
]

const redTeam = [
  { name:'阿興', normal:0, egg:0, money:0 },
  { name:'阿財', normal:0, egg:0, money:0 }
]

/* ====== 計算邏輯 ====== */
function calc(player){
  if(player.normal === 0) player.money = 0
  if(player.normal === 1) player.money = setting.normal1
  if(player.normal >= 2) player.money = setting.normal2
  player.money += player.egg * setting.egg
}

function render(){
  bluePlayers.innerHTML = ''
  redPlayers.innerHTML = ''

  renderTeam(bluePlayers, blueTeam)
  renderTeam(redPlayers, redTeam)
}

function renderTeam(dom, team){
  team.forEach(p=>{
    calc(p)
    const div = document.createElement('div')
    div.className = 'player'
    div.innerHTML = `
      ${p.name}｜
      普通球:${p.normal}
      <button onclick="p.normal++ ; render()">+1</button>
      <button onclick="p.normal=Math.max(0,p.normal-1); render()">-1</button>
      ｜彩蛋:${p.egg}
      <button onclick="p.egg++ ; render()">+1</button>
      <button onclick="p.egg=Math.max(0,p.egg-1); render()">-1</button>
      ｜金額：<span class="money">${p.money}</span>
    `
    dom.appendChild(div)
  })
}

render()
</script>

</body>
</html>
